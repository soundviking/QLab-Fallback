    "Relance le Live Mirror sans réactiver le son du BACKUP. Si une cue joue ou est en pause, l’application attendra le prochain moment sûr.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relance le Live Mirror sans réactiver le son du BACKUP. Si une cue joue ou est en pause, l’application attendra le prochain moment sûr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restarts Live Mirror without enabling BACKUP audio. If a cue is playing or paused, the app waits until it is safe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet Live Mirror neu, ohne BACKUP-Audio zu aktivieren. Bei laufenden oder pausierten Cues wartet die App auf einen sicheren Zeitpunkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia Live Mirror sin activar el audio BACKUP. Si una cue se reproduce o está en pausa, la app espera hasta que sea seguro."
          }
        }
      }
    },
