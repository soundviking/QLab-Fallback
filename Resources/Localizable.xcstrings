    "Le dossier projet complet est copié depuis le PRIMARY puis vérifié par SHA-256. Une copie existante n'est jamais écrasée.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier projet complet est copié depuis le PRIMARY puis vérifié par SHA-256. Une copie existante n'est jamais écrasée."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The complete project folder is copied from PRIMARY and verified with SHA-256. Existing copies are never overwritten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gesamte Projektordner wird von PRIMARY kopiert und mit SHA-256 geprüft. Vorhandene Kopien werden niemals überschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta completa del proyecto se copia desde PRIMARY y se verifica mediante SHA-256. Las copias existentes nunca se sobrescriben."
          }
        }
      }
    },
